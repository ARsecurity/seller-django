{
 "compilerOptions": {
  "target": "es2020",
  "lib": [
   "dom",
   "esnext"
  ],
  "jsx": "preserve",
  "module": "esnext",
  "moduleResolution": "bundler",
  "strict": true,
  "noEmit": true,
  "esModuleInterop": true,
  "skipLibCheck": true,
  "incremental": true,
  "plugins": [
   {
    "name": "next"
   }
  ],
  "baseUrl": ".",
  "paths": {
   "@/*": [
    "./*"
   ]
  }
 },
 "include": [
  "**/*.ts",
  "**/*.tsx",
  "next-env.d.ts"
 ],
 "exclude": [
  "node_modules"
 ]
}